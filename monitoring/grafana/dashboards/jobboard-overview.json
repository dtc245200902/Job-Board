      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Tần suất Request (QPS)",
      "type": "stat",
      "targets": [{ "expr": "sum(rate(jobboard_http_requests_total[1m]))", "legendFormat": "Req/sec" }]
