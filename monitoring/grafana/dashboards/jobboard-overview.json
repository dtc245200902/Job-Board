      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Độ trễ trung bình (Avg Latency)",
      "type": "stat",
      "targets": [{ "expr": "sum(rate(jobboard_http_request_duration_seconds_sum[1m])) / sum(rate(jobboard_http_request_duration_seconds_count[1m]))", "legendFormat": "Latency" }]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 101,
      "title": "Hiệu năng Web Server & Nginx Reverse Proxy",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "id": 5,
      "title": "Lưu lượng HTTP Request theo Đường dẫn (Route Traffic)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (route) (rate(jobboard_http_requests_total[1m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "id": 6,
      "title": "Phân bố Mã phản hồi HTTP (HTTP Status Distribution)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (status_code) (rate(jobboard_http_requests_total[1m]))", "legendFormat": "HTTP {{status_code}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "id": 7,
      "title": "Nginx Active Connections & Handled Requests",
      "type": "timeseries",
      "targets": [
        { "expr": "nginx_connections_active", "legendFormat": "Active Connections" },
        { "expr": "rate(nginx_connections_handled_total[1m])", "legendFormat": "Handled Conn/s" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 8,
      "title": "Bộ nhớ Node.js Process (RAM Usage)",
      "type": "timeseries",
      "targets": [
        { "expr": "jobboard_nodejs_heap_size_used_bytes", "legendFormat": "Heap Used" },
        { "expr": "jobboard_nodejs_heap_size_total_bytes", "legendFormat": "Heap Total" },
        { "expr": "jobboard_process_resident_memory_bytes", "legendFormat": "Resident Memory (RSS)" }
      ]
    }
