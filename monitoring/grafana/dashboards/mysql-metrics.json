{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Chỉ số Trạng thái MySQL Database",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Trạng thái MySQL Uptime",
      "type": "stat",
      "targets": [{ "expr": "mysql_up", "legendFormat": "MySQL Status" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Số Kết nối Hiện tại (Threads Connected)",
      "type": "stat",
      "targets": [{ "expr": "mysql_global_status_threads_connected", "legendFormat": "Connections" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 }
            ]
          },
          "unit": "qps"
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Tổng Số Câu Lệnh Truy Vấn (QPS)",
      "type": "stat",
      "targets": [{ "expr": "rate(mysql_global_status_queries[1m])", "legendFormat": "Queries/sec" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Số Truy Vấn Chậm (Slow Queries)",
      "type": "stat",
      "targets": [{ "expr": "mysql_global_status_slow_queries", "legendFormat": "Slow Queries" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "title": "Tần suất Lệnh MySQL theo Phân Loại (Commands/sec)",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(mysql_global_status_commands_total{command=~\"select|insert|update|delete\"}[1m])", "legendFormat": "{{command}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "title": "InnoDB Buffer Pool Utilization",
      "type": "timeseries",
      "targets": [
        { "expr": "mysql_global_status_buffer_pool_pages{state=\"data\"} * 16384", "legendFormat": "Buffer Pool Data Bytes" },
        { "expr": "mysql_global_status_buffer_pool_pages{state=\"free\"} * 16384", "legendFormat": "Buffer Pool Free Bytes" }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["mysql", "database", "monitoring"],
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "Job Board - Giám Sát Cơ Sở Dữ Liệu MySQL",
  "uid": "mysql-database-monitoring",
  "version": 1
}
