  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Tài Nguyên Máy Chủ & Hạ Tầng Container",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "CPU Sử Dụng Hệ Thống (CPU Utilization)",
      "type": "timeseries",
      "targets": [
        { "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))", "legendFormat": "Total CPU Busy" },
        { "expr": "avg(rate(node_cpu_seconds_total{mode=\"user\"}[1m]))", "legendFormat": "User Mode CPU" },
        { "expr": "avg(rate(node_cpu_seconds_total{mode=\"system\"}[1m]))", "legendFormat": "System Mode CPU" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "Bộ Nhớ RAM Hệ Thống (Memory Consumption)",
      "type": "timeseries",
      "targets": [
        { "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "Used RAM" },
        { "expr": "node_memory_MemAvailable_bytes", "legendFormat": "Available RAM" },
        { "expr": "node_memory_MemTotal_bytes", "legendFormat": "Total RAM" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ds" },
      "fieldConfig": {
        "defaults": { "unit": "binBps" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "id": 3,
      "title": "Lưu Lượng Mạng Network I/O (Receive / Transmit)",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|veth.*\"}[1m]))", "legendFormat": "Network Received (Rx)" },
        { "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|veth.*\"}[1m]))", "legendFormat": "Network Transmitted (Tx)" }
      ]
    }
  ],
  "refresh": "5s",
